{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SEQUENCE authored puzzle bank",
 "type": "object",
 "required": [
  "$schema",
  "puzzles"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "puzzles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "category",
     "difficulty",
     "sequence",
     "answer",
     "rule",
     "explanation",
     "hints",
     "pattern"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
     },
     "category": {
      "type": "string",
      "minLength": 1
     },
     "difficulty": {
      "enum": [
       "Easy",
       "Medium",
       "Hard",
       "Expert"
      ]
     },
     "sequence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
       "type": "integer"
      }
     },
     "answer": {
      "type": "integer"
     },
     "rule": {
      "type": "string",
      "minLength": 3
     },
     "explanation": {
      "type": "string",
      "minLength": 15
     },
     "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "string",
       "minLength": 4
      }
     },
     "pattern": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "type",
         "step"
        ],
        "properties": {
         "type": {
          "const": "arithmetic"
         },
         "step": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "factor"
        ],
        "properties": {
         "type": {
          "const": "geometric"
         },
         "factor": {
          "type": "integer",
          "minimum": 2
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "exponent",
         "start"
        ],
        "properties": {
         "type": {
          "const": "power"
         },
         "exponent": {
          "enum": [
           2,
           3
          ]
         },
         "start": {
          "type": "integer",
          "minimum": 1
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type"
        ],
        "properties": {
         "type": {
          "const": "fibonacci"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "oddStep",
         "evenStep"
        ],
        "properties": {
         "type": {
          "const": "alternating"
         },
         "oddStep": {
          "type": "integer"
         },
         "evenStep": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "firstDifference",
         "growth"
        ],
        "properties": {
         "type": {
          "const": "increasing-difference"
         },
         "firstDifference": {
          "type": "integer"
         },
         "growth": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "firstDifference"
        ],
        "properties": {
         "type": {
          "const": "doubling-difference"
         },
         "firstDifference": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "factor",
         "offset"
        ],
        "properties": {
         "type": {
          "const": "multiply-adjust"
         },
         "factor": {
          "type": "integer",
          "minimum": 2
         },
         "offset": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start"
        ],
        "properties": {
         "type": {
          "const": "factorial"
         },
         "start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start"
        ],
        "properties": {
         "type": {
          "const": "prime"
         },
         "start": {
          "type": "integer",
          "minimum": 2
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start"
        ],
        "properties": {
         "type": {
          "const": "triangular"
         },
         "start": {
          "type": "integer",
          "minimum": 1
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start"
        ],
        "properties": {
         "type": {
          "const": "look-and-say"
         },
         "start": {
          "enum": [
           1,
           2
          ]
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "factorA",
         "offsetA",
         "factorB",
         "offsetB"
        ],
        "properties": {
         "type": {
          "const": "alternating-operation"
         },
         "factorA": {
          "type": "integer",
          "minimum": 2
         },
         "offsetA": {
          "type": "integer"
         },
         "factorB": {
          "type": "integer",
          "minimum": 2
         },
         "offsetB": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "factor",
         "offset"
        ],
        "properties": {
         "type": {
          "const": "weighted-recurrence"
         },
         "factor": {
          "type": "integer",
          "minimum": 2
         },
         "offset": {
          "type": "integer"
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start"
        ],
        "properties": {
         "type": {
          "const": "reverse-add"
         },
         "start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start"
        ],
        "properties": {
         "type": {
          "const": "collatz"
         },
         "start": {
          "type": "integer",
          "minimum": 3
         }
        }
       },
       {
        "type": "object",
        "required": [
         "type",
         "start",
         "firstGap",
         "growth"
        ],
        "properties": {
         "type": {
          "const": "prime-gaps"
         },
         "start": {
          "type": "integer",
          "minimum": 2
         },
         "firstGap": {
          "type": "integer",
          "minimum": 1
         },
         "growth": {
          "type": "integer",
          "minimum": 1
         }
        }
       }
      ]
     }
    }
   }
  }
 }
}
